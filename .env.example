# Required
BOT_TOKEN=your_telegram_bot_token_here

# Local default. For deployment, use Postgres from Supabase/Neon if you want persistence.
DATABASE_URL=sqlite:///./interview_bot.db

TIMEZONE=Asia/Jerusalem
DAILY_QUESTION_HOUR=9
DAILY_QUESTION_MINUTE=0
DAILY_GRADE_HOUR=21
DAILY_GRADE_MINUTE=0
API_HOST=0.0.0.0
API_PORT=8000

# Grading options:
# local  = free deterministic rubric/keyword grading
# gemini = one Gemini API call per daily grading batch
GRADING_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_MAX_OUTPUT_TOKENS=5000
LLM_TEMPERATURE=0.1
